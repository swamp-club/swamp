{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    // The agent session record is imported from core (lib/agent_sessions/
    // record.ts); its bare zod import resolves to this package's copy.
    "paths": { "zod": ["./node_modules/zod"] }
  },
  "include": ["src"],
  "exclude": ["src/**/*_test.ts", "src/**/*_test.tsx"]
}
