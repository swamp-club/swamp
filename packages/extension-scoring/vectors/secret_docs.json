{
  "about": "Shared vectors for the secret-safe-docs check (swamp-club#3757, swamp-club#3781): which lines a text is flagged on in each form and with which argument schemas, which archive files are read and how (`unread` files fail the factor), which Markdown imports make a file data, and which findings an acceptance covers.",
  "detection": [
    {
      "name": "unsupported vault syntax in a fence",
      "text": "# Setup\n\n```bash\nswamp model create x --global-arg 'token=vault://v/k'\n```\n",
      "form": "markdown",
      "expectLines": [
        4
      ]
    },
    {
      "name": "prose naming the wrong form to warn against it",
      "text": "Never write `vault://v/k`.\n",
      "form": "markdown",
      "expectLines": []
    },
    {
      "name": "a credential shape in prose",
      "text": "Token: ghp_aB3dE5gH7jK9mN2paB3dE5gH7jK9mN2paB3dE5gH7jK9mN2p\n",
      "form": "markdown",
      "expectLines": [
        1
      ]
    },
    {
      "name": "a repeated-run placeholder",
      "text": "glpat-xxxxxxxxxxxxxxxxxxxx\n",
      "form": "markdown",
      "expectLines": []
    },
    {
      "name": "vault put with the value on the command line",
      "text": "# Setup\n\n```bash\nswamp vault put prod token hunter2\n```\n",
      "form": "markdown",
      "expectLines": [
        4
      ]
    },
    {
      "name": "vault put with a shell variable",
      "text": "# Setup\n\n```bash\nswamp vault put prod token \"$TOKEN\"\n```\n",
      "form": "markdown",
      "expectLines": []
    },
    {
      "name": "vault put against a server",
      "text": "# Setup\n\n```bash\nswamp vault put prod token hunter2 --server https://x\n```\n",
      "form": "markdown",
      "expectLines": []
    },
    {
      "name": "an undeclared secret-named argument set to a value",
      "text": "# Setup\n\n```bash\n--input apiKey=abc\n```\n",
      "form": "markdown",
      "expectLines": [
        4
      ]
    },
    {
      "name": "a declared argument that is not sensitive",
      "text": "# Setup\n\n```bash\n--input apiKey=abc\n```\n",
      "form": "markdown",
      "schemas": {
        "declared": [
          "apiKey"
        ],
        "sensitive": []
      },
      "expectLines": []
    },
    {
      "name": "a sensitive argument with a harmless name",
      "text": "# Setup\n\n```bash\n--input pin=1234\n```\n",
      "form": "markdown",
      "schemas": {
        "declared": [
          "pin"
        ],
        "sensitive": [
          "pin"
        ]
      },
      "expectLines": [
        4
      ]
    },
    {
      "name": "a vault expression is fine",
      "text": "# Setup\n\n```bash\n--input apiKey='${{ vault.get(v, k) }}'\n```\n",
      "form": "markdown",
      "expectLines": []
    },
    {
      "name": "plain text checks every line",
      "text": "Models.\n\n  --global-arg 'token=vault://v/k'",
      "form": "plain",
      "expectLines": [
        3
      ]
    },
    {
      "name": "source reads describe strings only",
      "text": "const token = 'vault://x';\n  t: z.string().describe(\"vault:// ref\"),",
      "form": "source",
      "expectLines": [
        2
      ]
    }
  ],
  "selection": [
    {
      "name": "markdown and source, tests skipped",
      "files": [
        {
          "path": "files/README.md",
          "size": 10
        },
        {
          "path": "models/m.ts",
          "size": 10
        },
        {
          "path": "models/m_test.ts",
          "size": 10
        }
      ],
      "manifest": {},
      "importedMarkdown": [],
      "expect": {
        "targets": [
          {
            "path": "files/README.md",
            "form": "markdown"
          },
          {
            "path": "models/m.ts",
            "form": "source"
          }
        ],
        "truncated": false,
        "unread": []
      }
    },
    {
      "name": "binaries and include entries are not docs",
      "files": [
        {
          "path": "files/guide.md",
          "size": 10
        },
        {
          "path": "models/shared/notes.md",
          "size": 10
        },
        {
          "path": "files/README.md",
          "size": 10
        }
      ],
      "manifest": {
        "binaries": [
          "guide.md"
        ],
        "include": [
          "shared/notes.md"
        ]
      },
      "importedMarkdown": [],
      "expect": {
        "targets": [
          {
            "path": "files/README.md",
            "form": "markdown"
          }
        ],
        "truncated": false,
        "unread": []
      }
    },
    {
      "name": "markdown a module imports is data",
      "files": [
        {
          "path": "models/prompt.md",
          "size": 10
        },
        {
          "path": "models/m.ts",
          "size": 10
        }
      ],
      "manifest": {},
      "importedMarkdown": [
        "models/prompt.md"
      ],
      "expect": {
        "targets": [
          {
            "path": "models/m.ts",
            "form": "source"
          }
        ],
        "truncated": false,
        "unread": []
      }
    },
    {
      "name": "code outside the kind directories is read",
      "files": [
        {
          "path": "lib/x.ts",
          "size": 10
        },
        {
          "path": "_shared/y.ts",
          "size": 10
        }
      ],
      "manifest": {},
      "importedMarkdown": [],
      "expect": {
        "targets": [
          {
            "path": "_shared/y.ts",
            "form": "source"
          },
          {
            "path": "lib/x.ts",
            "form": "source"
          }
        ],
        "truncated": false,
        "unread": []
      }
    },
    {
      "name": "a file over 1 MiB is unread",
      "files": [
        {
          "path": "files/CHANGELOG.md",
          "size": 1048577
        },
        {
          "path": "files/README.md",
          "size": 1048576
        }
      ],
      "manifest": {},
      "importedMarkdown": [],
      "expect": {
        "targets": [
          {
            "path": "files/README.md",
            "form": "markdown"
          }
        ],
        "truncated": true,
        "unread": [
          "files/CHANGELOG.md"
        ]
      }
    }
  ],
  "markdownImports": [
    {
      "name": "a relative import of a .md file",
      "path": "models/m.ts",
      "source": "import p from \"./prompt.md\" with { type: \"text\" };\nimport y from \"../lib/notes.md\";",
      "expect": [
        "models/prompt.md",
        "lib/notes.md"
      ]
    },
    {
      "name": "a commented-out or bare one is not",
      "path": "models/m.ts",
      "source": "// import p from \"./a.md\";\nimport q from \"b.md\";",
      "expect": []
    }
  ],
  "acceptance": [
    {
      "name": "a line acceptance covers its line only",
      "acceptances": [
        {
          "rule": "secret-unsafe-docs",
          "file": "files/README.md",
          "line": 4
        }
      ],
      "findings": [
        {
          "file": "files/README.md",
          "line": 4
        },
        {
          "file": "files/README.md",
          "line": 5
        }
      ],
      "expectAccepted": [
        true,
        false
      ]
    },
    {
      "name": "a fileless acceptance covers every description finding",
      "acceptances": [
        {
          "rule": "secret-unsafe-docs"
        }
      ],
      "findings": [
        {
          "line": 1
        },
        {
          "line": 3
        },
        {
          "file": "files/README.md",
          "line": 1
        }
      ],
      "expectAccepted": [
        true,
        true,
        false
      ]
    },
    {
      "name": "another rule's acceptance covers nothing",
      "acceptances": [
        {
          "rule": "other",
          "file": "files/README.md",
          "line": 4
        }
      ],
      "findings": [
        {
          "file": "files/README.md",
          "line": 4
        }
      ],
      "expectAccepted": [
        false
      ]
    }
  ]
}
