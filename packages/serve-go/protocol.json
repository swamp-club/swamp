{
  "version": 1,
  "profile": "local-v1",
  "framing": "uint32-be-length-prefixed-utf8-json",
  "channels": {
    "requests": "dedicated-inherited-pipe",
    "replies": "dedicated-inherited-pipe",
    "extensionOutput": "null"
  },
  "limits": {
    "frameBytes": 8388608,
    "queuedBytes": 8388608,
    "sessionFrames": 10000,
    "sessions": 128,
    "pendingControls": 128,
    "coldWaiters": 64,
    "engineSessionFrames": 64,
    "engineSessionBytes": 8058880,
    "engineAuthentications": 64,
    "engineControlBytes": 65536,
    "engineCloseFrameBytes": 2048,
    "maxShutdownDeadlineMs": 2147483647,
    "commandGuardians": 256,
    "compressionThresholdBytes": 16384,
    "httpRequestBodyBytes": 65536,
    "httpRequestsInFlight": 100
  },
  "operations": [
    "server.version",
    "workflow.get",
    "model.get",
    "data.query",
    "workflow.run",
    "model.method.run",
    "run.attach",
    "run.history",
    "workflow.history.get",
    "workflow.history.logs",
    "model.method.history.get",
    "model.method.history.logs",
    "cancel"
  ],
  "controls": [
    "hello",
    "session.open",
    "session.close",
    "request.dispatch",
    "engine.status",
    "engine.quiesce",
    "engine.shutdown",
    "health.snapshot"
  ],
  "hubControl": {
    "profile": "hub-control-v1",
    "controls": [
      "hello",
      "workspace.resolve",
      "workspace.list",
      "workspace.inspect",
      "asset.get",
      "engine.status",
      "engine.quiesce",
      "engine.shutdown"
    ]
  },
  "callerClasses": {
    "page": {
      "operations": [
        "audit.query",
        "audit.subscribe",
        "audit.unsubscribe",
        "cancel",
        "cluster.instances",
        "data.get",
        "data.query",
        "data.search",
        "data.versions",
        "datastore.status",
        "extension.list",
        "model.get",
        "model.output.search",
        "model.search",
        "model.usage.summary",
        "serve.config",
        "vault.audit-trail",
        "vault.describe",
        "vault.list-keys",
        "vault.search",
        "worker.list",
        "workflow.approvals",
        "workflow.approve",
        "workflow.cancel",
        "workflow.get",
        "workflow.history.get",
        "workflow.history.logs",
        "workflow.reject",
        "workflow.resume",
        "workflow.run.search",
        "workflow.run.summary",
        "workflow.search",
        "workflow.trigger.get",
        "workflow.waits"
      ],
      "reads": [
        "audit.query",
        "audit.subscribe",
        "audit.unsubscribe",
        "cluster.instances",
        "data.get",
        "data.query",
        "data.search",
        "data.versions",
        "datastore.status",
        "extension.list",
        "model.get",
        "model.output.search",
        "model.search",
        "model.usage.summary",
        "serve.config",
        "vault.audit-trail",
        "vault.describe",
        "vault.list-keys",
        "vault.search",
        "worker.list",
        "workflow.approvals",
        "workflow.get",
        "workflow.history.get",
        "workflow.history.logs",
        "workflow.run.search",
        "workflow.run.summary",
        "workflow.search",
        "workflow.trigger.get",
        "workflow.waits"
      ],
      "actions": [
        "workflow.approve",
        "workflow.reject",
        "workflow.resume",
        "workflow.cancel"
      ],
      "httpOperations": [
        "data.get",
        "data.query",
        "data.versions",
        "model.output.search",
        "workflow.history.get",
        "workflow.history.logs"
      ],
      "refusalMessage": "${type} is not available on the local dashboard. Run it with the swamp CLI, or through swamp serve.",
      "httpRefusalMessage": "'${type}' is not answered over HTTP here; send it over the WebSocket",
      "httpUnsupportedMessage": "'${type}' is not answered over HTTP; send it over the WebSocket"
    }
  }
}
