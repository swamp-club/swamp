        "from": "lockfile",
        "kind": "range"
      }
    },
    {
      "name": "stale lock falls through",
      "registry": "npm",
      "spec": "^1.2.0",
      "locked": [
        "1.0.0"
      ],
      "published": {
        "versions": [
          "1.0.0",
          "1.2.5"
        ],
        "distTags": {
          "latest": "1.2.5"
        }
      },
      "expect": {
        "version": "1.2.5",
        "from": "registry",
        "kind": "range"
      }
    },
    {
      "name": "lock entry for the specifier beats a higher transitive copy",
      "registry": "npm",
      "spec": "^1.0.0",
      "locked": [
        "1.0.0",
        "1.2.5"
      ],
      "lockedFor": "1.0.0",
      "published": {
        "versions": [
          "1.0.0",
          "1.2.5"
        ],
        "distTags": {
          "latest": "1.2.5"
        }
      },
      "expect": {
        "version": "1.0.0",
        "from": "lockfile",
        "kind": "range"
      }
    },
    {
      "name": "jsr range skips yanked",
      "registry": "jsr",
      "spec": "^0.225.0",
      "published": {
        "versions": [
          "0.225.0",
          "0.225.1",
          "0.225.2"
        ],
        "distTags": {
          "latest": "0.225.1"
        },
        "yanked": [
          "0.225.2"
        ]
