        "version": null,
        "kind": "range"
      }
    },
    {
      "name": "lock decides a range",
      "registry": "npm",
      "spec": "^1.0.0",
      "locked": [
        "1.0.0"
      ],
      "published": {
        "versions": [
          "1.0.0",
          "1.2.5"
        ],
        "distTags": {
          "latest": "1.2.5"
        }
      },
      "expect": {
