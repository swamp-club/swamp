      "expect": {
        "version": "0.228.0",
        "from": "registry",
        "kind": "range"
      }
    },
    {
      "name": "jsr range skips prereleases",
      "registry": "jsr",
      "spec": "1",
      "published": {
        "versions": [
          "1.0.0",
          "1.1.0-rc.1"
        ],
        "distTags": {
          "latest": "1.0.0"
        }
