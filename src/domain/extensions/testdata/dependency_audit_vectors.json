          "latest": "1.0.0",
          "versions": {
            "0.225.0": {
              "yanked": true
            },
            "1.0.0": {}
          }
        }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "version 0.225.0 was withdrawn (yanked) by its author on JSR. Newest version that isn't yanked: 1.0.0.",
