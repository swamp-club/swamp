      "spec": "1",
      "published": {
        "versions": [
          "1.0.0",
          "1.9.0",
          "2.0.0"
        ],
        "distTags": {
          "latest": "2.0.0"
        }
      },
      "expect": {
        "version": "1.9.0",
        "from": "registry",
        "kind": "range"
      }
    },
    {
      "name": "prerelease excluded from a range",
      "registry": "npm",
      "spec": "^1.0.0",
      "published": {
        "versions": [
          "1.0.0",
          "1.1.0-beta.1"
        ],
        "distTags": {
