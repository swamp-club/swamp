  ],
  "findings": [
    {
      "name": "deprecated pin, latest not deprecated",
      "registry": "npm",
      "package": "pkg",
      "spec": "1.0.0",
      "npm": {
        "dist-tags": {
          "latest": "2.0.0"
        },
        "versions": {
          "1.0.0": {
            "license": "MIT",
            "maintainers": [
              {
                "name": "a"
              }
            ],
            "deprecated": "Use 2.x"
          },
          "2.0.0": {
            "license": "MIT",
            "maintainers": [
              {
                "name": "a"
              }
            ]
          }
        }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "version 1.0.0 is deprecated: Use 2.x",
          "cause": "deprecated-version",
          "pointsLost": 2
        }
      ]
    },
    {
      "name": "deprecated pin of a deprecated package",
      "registry": "npm",
      "package": "pkg",
      "spec": "1.0.0",
      "npm": {
        "dist-tags": {
          "latest": "2.0.0"
        },
        "versions": {
          "1.0.0": {
            "license": "MIT",
            "maintainers": [
              {
                "name": "a"
              }
            ],
            "deprecated": "gone"
          },
          "2.0.0": {
            "license": "MIT",
            "maintainers": [
              {
                "name": "a"
              }
            ],
            "deprecated": "gone"
          }
        }
      },
      "expect": [
        {
          "severity": "error",
          "message": "package is deprecated",
          "pointsLost": 2
        }
      ]
    },
    {
      "name": "good pin, latest deprecated",
      "registry": "npm",
      "package": "pkg",
      "spec": "1.0.0",
      "npm": {
        "dist-tags": {
          "latest": "2.0.0"
        },
        "versions": {
          "1.0.0": {
            "license": "MIT",
            "maintainers": [
              {
                "name": "a"
              }
            ]
          },
          "2.0.0": {
            "license": "MIT",
            "maintainers": [
              {
                "name": "a"
              }
            ],
            "deprecated": "stub"
          }
        }
      },
      "expect": []
    },
    {
      "name": "npm range",
      "registry": "npm",
      "package": "pkg",
      "spec": "^1.0.0",
      "npm": {
        "dist-tags": {
          "latest": "1.2.0"
        },
        "versions": {
          "1.0.0": {
            "license": "MIT",
            "maintainers": [
              {
                "name": "a"
              }
            ]
          },
          "1.2.0": {
            "license": "MIT",
            "maintainers": [
              {
                "name": "a"
              }
            ]
          }
        }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "npm:pkg@^1.0.0 is a range; audited 1.2.0, the version this push resolves",
          "cause": "loose-specifier",
          "pointsLost": 1
        }
      ],
      "scorecardMessage": "npm:pkg@^1.0.0 is a range; audited 1.2.0, the version the registry resolved"
    },
    {
      "name": "npm unpinned",
