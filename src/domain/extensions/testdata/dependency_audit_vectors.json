      "expect": {
        "version": "0.225.1",
        "from": "registry",
        "kind": "range"
      }
    },
    {
      "name": "jsr range falls back to yanked",
      "registry": "jsr",
      "spec": "~0.228.0",
      "published": {
        "versions": [
          "0.228.0",
          "1.0.0"
        ],
        "distTags": {
          "latest": "1.0.0"
        },
        "yanked": [
          "0.228.0"
        ]
