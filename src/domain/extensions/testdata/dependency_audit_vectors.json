{
  "about": "Shared vectors for the dependency audit (swamp-club#3352 push, swamp-club#3353 scorecard). Copy verbatim; the swamp copy is the source. `resolution`: the version that ships for a specifier; `locked` lists every version a lockfile records for the package, `lockedFor` the version it records for this specifier itself. `findings`: the exact findings push reports for one specifier, given the registry's answer; `scorecardMessage`, where present, is the scorecard's wording of the same finding. Each expected finding's `costsPoint` says whether it costs the rubric's dependency-trust point: every error, every `not-audited` and every `deprecated-version` does; push still only warns on `deprecated-version` until swamp-club#3354.",
  "resolution": [
    {
      "name": "exact pin",
      "registry": "npm",
      "spec": "1.2.0",
      "published": {
        "versions": ["1.0.0", "1.2.0", "1.2.5"],
        "distTags": { "latest": "1.2.5" }
      },
      "expect": { "version": "1.2.0", "from": "exact", "kind": "exact" }
    },
    {
      "name": "= exact pin",
      "registry": "npm",
      "spec": "=1.2.0",
      "published": { "versions": ["1.2.0"], "distTags": {} },
      "expect": { "version": "1.2.0", "from": "exact", "kind": "exact" }
    },
    {
      "name": "v exact pin",
      "registry": "npm",
      "spec": "v1.2.0",
      "published": { "versions": ["1.2.0"], "distTags": {} },
      "expect": { "version": "1.2.0", "from": "exact", "kind": "exact" }
    },
    {
      "name": "caret range",
      "registry": "npm",
      "spec": "^1.0.0",
      "published": {
        "versions": ["1.0.0", "1.2.5", "2.0.0"],
        "distTags": { "latest": "2.0.0" }
      },
      "expect": { "version": "1.2.5", "from": "registry", "kind": "range" }
    },
    {
      "name": "tilde range",
      "registry": "npm",
      "spec": "~1.2.0",
      "published": {
        "versions": ["1.2.0", "1.2.5", "1.3.0"],
        "distTags": { "latest": "1.3.0" }
      },
      "expect": { "version": "1.2.5", "from": "registry", "kind": "range" }
    },
    {
      "name": "bare major",
      "registry": "npm",
      "spec": "1",
      "published": {
        "versions": ["1.0.0", "1.9.0", "2.0.0"],
        "distTags": { "latest": "2.0.0" }
      },
      "expect": { "version": "1.9.0", "from": "registry", "kind": "range" }
    },
    {
      "name": "prerelease excluded from a range",
      "registry": "npm",
      "spec": "^1.0.0",
      "published": {
        "versions": ["1.0.0", "1.1.0-beta.1"],
        "distTags": { "latest": "1.0.0" }
      },
      "expect": { "version": "1.0.0", "from": "registry", "kind": "range" }
    },
    {
      "name": "unpinned is latest",
      "registry": "npm",
      "spec": null,
      "published": {
        "versions": ["1.0.0", "2.0.0"],
        "distTags": { "latest": "1.0.0" }
      },
      "expect": { "version": "1.0.0", "from": "registry", "kind": "unpinned" }
    },
    {
      "name": "dist-tag",
      "registry": "npm",
      "spec": "next",
      "published": {
        "versions": ["1.0.0", "2.0.0-rc.1"],
        "distTags": { "latest": "1.0.0", "next": "2.0.0-rc.1" }
      },
      "expect": {
        "version": "2.0.0-rc.1",
        "from": "registry",
        "kind": "dist-tag"
      }
    },
    {
      "name": "range nothing satisfies",
      "registry": "npm",
      "spec": "^9.0.0",
      "published": { "versions": ["1.0.0"], "distTags": { "latest": "1.0.0" } },
      "expect": { "version": null, "kind": "range" }
    },
    {
      "name": "lock decides a range",
      "registry": "npm",
      "spec": "^1.0.0",
      "locked": ["1.0.0"],
      "published": {
        "versions": ["1.0.0", "1.2.5"],
        "distTags": { "latest": "1.2.5" }
      },
      "expect": { "version": "1.0.0", "from": "lockfile", "kind": "range" }
    },
    {
      "name": "stale lock falls through",
      "registry": "npm",
      "spec": "^1.2.0",
      "locked": ["1.0.0"],
      "published": {
        "versions": ["1.0.0", "1.2.5"],
        "distTags": { "latest": "1.2.5" }
      },
      "expect": { "version": "1.2.5", "from": "registry", "kind": "range" }
    },
    {
      "name": "lock entry for the specifier beats a higher transitive copy",
      "registry": "npm",
      "spec": "^1.0.0",
      "locked": ["1.0.0", "1.2.5"],
      "lockedFor": "1.0.0",
      "published": {
        "versions": ["1.0.0", "1.2.5"],
        "distTags": { "latest": "1.2.5" }
      },
      "expect": { "version": "1.0.0", "from": "lockfile", "kind": "range" }
    },
    {
      "name": "jsr range skips yanked",
      "registry": "jsr",
      "spec": "^0.225.0",
      "published": {
        "versions": ["0.225.0", "0.225.1", "0.225.2"],
        "distTags": { "latest": "0.225.1" },
        "yanked": ["0.225.2"]
      },
      "expect": { "version": "0.225.1", "from": "registry", "kind": "range" }
    },
    {
      "name": "jsr range falls back to yanked",
      "registry": "jsr",
      "spec": "~0.228.0",
      "published": {
        "versions": ["0.228.0", "1.0.0"],
        "distTags": { "latest": "1.0.0" },
        "yanked": ["0.228.0"]
      },
      "expect": { "version": "0.228.0", "from": "registry", "kind": "range" }
    },
    {
      "name": "jsr range skips prereleases",
      "registry": "jsr",
      "spec": "1",
      "published": {
        "versions": ["1.0.0", "1.1.0-rc.1"],
        "distTags": { "latest": "1.0.0" }
      },
      "expect": { "version": "1.0.0", "from": "registry", "kind": "range" }
    },
    {
      "name": "jsr unpinned is latest",
      "registry": "jsr",
      "spec": null,
      "published": {
        "versions": ["1.0.0", "1.1.6"],
        "distTags": { "latest": "1.1.6" }
      },
      "expect": { "version": "1.1.6", "from": "registry", "kind": "unpinned" }
    }
  ],
  "findings": [
    {
      "name": "deprecated pin, latest not deprecated",
      "registry": "npm",
      "package": "pkg",
      "spec": "1.0.0",
      "npm": {
        "dist-tags": { "latest": "2.0.0" },
        "versions": {
          "1.0.0": {
            "license": "MIT",
            "maintainers": [{ "name": "a" }],
            "deprecated": "Use 2.x"
          },
          "2.0.0": { "license": "MIT", "maintainers": [{ "name": "a" }] }
        }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "version 1.0.0 is deprecated: Use 2.x",
          "cause": "deprecated-version",
          "costsPoint": true
        }
      ]
    },
    {
      "name": "deprecated pin of a deprecated package",
      "registry": "npm",
      "package": "pkg",
      "spec": "1.0.0",
      "npm": {
        "dist-tags": { "latest": "2.0.0" },
        "versions": {
          "1.0.0": {
            "license": "MIT",
            "maintainers": [{ "name": "a" }],
            "deprecated": "gone"
          },
          "2.0.0": {
            "license": "MIT",
            "maintainers": [{ "name": "a" }],
            "deprecated": "gone"
          }
        }
      },
      "expect": [
        {
          "severity": "error",
          "message": "package is deprecated",
          "costsPoint": true
        }
      ]
    },
    {
      "name": "good pin, latest deprecated",
      "registry": "npm",
      "package": "pkg",
      "spec": "1.0.0",
      "npm": {
        "dist-tags": { "latest": "2.0.0" },
        "versions": {
          "1.0.0": { "license": "MIT", "maintainers": [{ "name": "a" }] },
          "2.0.0": {
            "license": "MIT",
            "maintainers": [{ "name": "a" }],
            "deprecated": "stub"
          }
        }
      },
      "expect": []
    },
    {
      "name": "npm range",
      "registry": "npm",
      "package": "pkg",
      "spec": "^1.0.0",
      "npm": {
        "dist-tags": { "latest": "1.2.0" },
        "versions": {
          "1.0.0": { "license": "MIT", "maintainers": [{ "name": "a" }] },
          "1.2.0": { "license": "MIT", "maintainers": [{ "name": "a" }] }
        }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "npm:pkg@^1.0.0 is a range; audited 1.2.0, the version this push resolves",
          "cause": "loose-specifier",
          "costsPoint": false
        }
      ],
      "scorecardMessage": "npm:pkg@^1.0.0 is a range; audited 1.2.0, the version the registry resolved"
    },
    {
      "name": "npm unpinned",
      "registry": "npm",
      "package": "pkg",
      "spec": null,
      "npm": {
        "dist-tags": { "latest": "1.2.0" },
        "versions": {
          "1.2.0": { "license": "MIT", "maintainers": [{ "name": "a" }] }
        }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "npm:pkg is unpinned; audited 1.2.0, the version this push resolves",
          "cause": "loose-specifier",
          "costsPoint": false
        }
      ],
      "scorecardMessage": "npm:pkg is unpinned; audited 1.2.0, the version the registry resolved"
    },
    {
      "name": "npm dist-tag",
      "registry": "npm",
      "package": "pkg",
      "spec": "latest",
      "npm": {
        "dist-tags": { "latest": "1.2.0" },
        "versions": {
          "1.2.0": { "license": "MIT", "maintainers": [{ "name": "a" }] }
        }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "npm:pkg@latest is a dist-tag; audited 1.2.0, the version this push resolves",
          "cause": "loose-specifier",
          "costsPoint": false
        }
      ],
      "scorecardMessage": "npm:pkg@latest is a dist-tag; audited 1.2.0, the version the registry resolved"
    },
    {
      "name": "npm range from the lock",
      "registry": "npm",
      "package": "pkg",
      "spec": "^1.0.0",
      "locked": ["1.0.0"],
      "npm": {
        "dist-tags": { "latest": "1.2.0" },
        "versions": {
          "1.0.0": { "license": "MIT", "maintainers": [{ "name": "a" }] },
          "1.2.0": { "license": "MIT", "maintainers": [{ "name": "a" }] }
        }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "npm:pkg@^1.0.0 is a range; audited 1.0.0, the version this push resolves (from deno.lock)",
          "cause": "loose-specifier",
          "costsPoint": false
        }
      ],
      "scorecardMessage": "npm:pkg@^1.0.0 is a range; audited 1.0.0, the version the registry resolved (from deno.lock)"
    },
    {
      "name": "jsr version exists",
      "registry": "jsr",
      "package": "@std/assert",
      "spec": "1.0.0",
      "jsr": {
        "status": 200,
        "body": { "latest": "1.0.0", "versions": { "1.0.0": {} } }
      },
      "expect": []
    },
    {
      "name": "jsr version yanked",
      "registry": "jsr",
      "package": "@std/assert",
      "spec": "0.225.0",
      "jsr": {
        "status": 200,
        "body": {
          "latest": "1.0.0",
          "versions": { "0.225.0": { "yanked": true }, "1.0.0": {} }
        }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "version 0.225.0 is yanked on JSR",
          "cause": "jsr-yanked",
          "costsPoint": false
        }
      ]
    },
    {
      "name": "jsr version missing",
      "registry": "jsr",
      "package": "@std/assert",
      "spec": "0.0.999",
      "jsr": {
        "status": 200,
        "body": { "latest": "1.0.0", "versions": { "1.0.0": {} } }
      },
      "expect": [
        {
          "severity": "error",
          "message": "version 0.0.999 not found on JSR",
          "cause": "jsr-missing",
          "costsPoint": true
        }
      ]
    },
    {
      "name": "jsr range nothing satisfies",
      "registry": "jsr",
      "package": "@std/assert",
      "spec": "^9.0.0",
      "jsr": {
        "status": 200,
        "body": { "latest": "1.0.0", "versions": { "1.0.0": {} } }
      },
      "expect": [
        {
          "severity": "error",
          "message": "version ^9.0.0 not found on JSR",
          "cause": "jsr-missing",
          "costsPoint": true
        }
      ]
    },
    {
      "name": "jsr package missing",
      "registry": "jsr",
      "package": "@swamp-nonexistent/zzz",
      "spec": "1.0.0",
      "jsr": { "status": 404, "body": null },
      "expect": [
        {
          "severity": "error",
          "message": "JSR package not found",
          "cause": "jsr-missing",
          "costsPoint": true
        }
      ]
    },
    {
      "name": "jsr invalid name",
      "registry": "jsr",
      "package": "@Bad/Name",
      "spec": "1.0.0",
      "jsr": {
        "status": 200,
        "body": { "latest": "1.0.0", "versions": { "1.0.0": {} } }
      },
      "expect": [
        {
          "severity": "error",
          "message": "invalid JSR package name",
          "cause": "jsr-missing",
          "costsPoint": true
        }
      ]
    },
    {
      "name": "jsr outage",
      "registry": "jsr",
      "package": "@std/assert",
      "spec": "1.0.0",
      "jsr": { "status": 503, "body": null },
      "expect": [
        {
          "severity": "warning",
          "message": "not audited: JSR lookup failed (HTTP 503)",
          "cause": "not-audited",
          "costsPoint": true
        }
      ]
    },
    {
      "name": "jsr range",
      "registry": "jsr",
      "package": "@std/assert",
      "spec": "1",
      "jsr": {
        "status": 200,
        "body": { "latest": "1.0.2", "versions": { "1.0.2": {} } }
      },
      "expect": [
        {
          "severity": "warning",
          "message": "jsr:@std/assert@1 is a range; audited 1.0.2, the version this push resolves",
          "cause": "loose-specifier",
          "costsPoint": false
        }
      ],
      "scorecardMessage": "jsr:@std/assert@1 is a range; audited 1.0.2, the version the registry resolved"
    }
  ]
}
