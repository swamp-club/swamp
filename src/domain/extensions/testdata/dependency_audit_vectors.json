      "spec": null,
      "published": {
        "versions": [
          "1.0.0",
          "1.1.6"
        ],
        "distTags": {
          "latest": "1.1.6"
        }
      },
      "expect": {
        "version": "1.1.6",
        "from": "registry",
        "kind": "unpinned"
      }
