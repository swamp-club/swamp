      "jsr": {
        "status": 200,
        "body": {
          "latest": "1.0.0",
          "versions": {
            "1.0.0": {}
          }
        }
      },
      "expect": [
        {
          "severity": "error",
          "message": "invalid JSR package name",
          "cause": "jsr-missing",
          "pointsLost": 2
        }
      ]
    },
    {
      "name": "jsr outage",
      "registry": "jsr",
      "package": "@std/assert",
      "spec": "1.0.0",
      "jsr": {
        "status": 503,
        "body": null
      },
      "expect": [
        {
          "severity": "warning",
          "message": "not audited: JSR lookup failed (HTTP 503)",
          "cause": "not-audited",
          "pointsLost": 2
        }
      ]
    },
    {
      "name": "jsr range",
      "registry": "jsr",
      "package": "@std/assert",
      "spec": "1",
      "jsr": {
        "status": 200,
        "body": {
          "latest": "1.0.2",
          "versions": {
            "1.0.2": {}
