      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 32,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "candidates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "thin": {
      "type": "boolean"
    },
    "interactive": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headless": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kinds": {
      "type": "object",
      "properties": {
        "prompt-repeat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "call-sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "covered-cli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "headless-job": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "prompt-repeat",
        "call-sequence",
        "covered-cli",
        "headless-job"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "since",
    "until",
    "harnesses",
    "candidates",
    "thin",
    "interactive",
    "headless",
    "kinds"
  ],
  "additionalProperties": false
