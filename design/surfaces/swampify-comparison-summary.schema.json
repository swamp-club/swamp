{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "optionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "behavior",
            "workflow"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "historyOccurrences": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "forwardRaw": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "forwardSwamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "breakEven": {
      "type": "object",
      "properties": {
        "low": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "high": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "low",
        "high"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "optionId",
    "target",
    "outcome",
    "historyOccurrences",
    "forwardRaw",
    "forwardSwamp",
    "breakEven"
  ],
  "additionalProperties": false
}
