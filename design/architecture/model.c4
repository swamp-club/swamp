// C4 model of swamp. Source of truth for the diagrams in design/architecture.md.
//
// Regenerate with `deno task diagrams:render`; `deno task diagrams:check` runs
// in CI and fails when the generated Mermaid is stale. Element ids under
// `swamp` mirror directories in src/ so the model can be checked against the
// tree. People are the swamp-uat personas; dynamic views link to the UAT test
// that proves the journey.

specification {
  element person {
    style { shape person }
  }
  element system
  element container
  element component
  element datastore {
    style { shape storage }
  }

  relationship uses
}

model {
  // ---- People (swamp-uat personas) ----------------------------------------

  builder = person 'Builder' {
    description 'Works through an AI coding agent (Claude Code, Cursor, Kiro, Codex, Copilot, opencode). Creates models and workflows, runs them, reads data.'
  }
  author = person 'Extension author' {
    description 'Packages model types, vaults, datastores and reports; publishes them to a swamp-club collective.'
  }
  operator = person 'Platform operator' {
    description 'Runs swamp serve on a shared datastore, mints tokens, writes grants, enrols worker fleets.'
  }
  member = person 'Team member' {
    description 'Runs workflows through a serve instance with --server or the dashboard.'
  }
  integrator = person 'Integrator system' {
    description 'GitHub, Jira, Linear, Stripe or Slack posting HMAC-signed webhooks.'
  }

  // ---- External systems ----------------------------------------------------

  club = system 'swamp-club' {
    description 'Hosted API: extension registry, identity provider (OAuth device grant, OIDC), issues lab, telemetry ingest, binary artifacts.'
  }
  wrapped = system 'Systems wrapped by models' {
    description 'Whatever a model type talks to: AWS Cloud Control, a shell, any API.'
  }
  backends = system 'Extension-provided backends' {
    description 'S3 datastore, AWS Secrets Manager, Azure Key Vault, 1Password — loaded in-process from extensions.'
  }
  otel = system 'OpenTelemetry collector' {
    description 'Optional; enabled purely by OTEL_* environment variables.'
  }
  osd = system 'OS service manager' {
    description 'launchd / systemd / cron units generated by swamp to keep serve, workers and autoupdate running.'
  }

  // ---- swamp ---------------------------------------------------------------

  swamp = system 'swamp' {
    description 'Models · Data · Workflows · Vaults · Extensions · Serve. One Deno-compiled binary that plays every runtime role.'

    cli = container 'swamp CLI' {
      technology 'Deno, Cliffy, Ink'
      description 'Every user command. Composition root in src/cli/mod.ts; Ink pickers for interactive selection.'
      link ../../src/cli

      commands = component 'commands' {
        description 'One Cliffy command per verb; parses args, builds deps, hands a libswamp stream to a renderer.'
        link ../../src/cli/commands
      }
      presentation = component 'presentation' {
        description 'Renderers for log and json output modes, Ink components.'
        link ../../src/presentation
      }
      libswamp = component 'libswamp' {
        description 'Application layer: ~136 async-generator use cases, one per verb. Shared with serve handlers.'
        link ../../src/libswamp
      }
      domain = component 'domain' {
        description 'Bounded contexts: models, data, workflows, vaults, extensions, datastore, access, auth, remote, repo…'
        link ../../src/domain
      }
      infrastructure = component 'infrastructure' {
        description 'Adapters: YAML/JSONL/SQLite persistence, HTTP clients, CEL evaluator, tracing, embedded Deno runtime.'
        link ../../src/infrastructure
      }

      commands -> libswamp 'consumes use-case streams'
      commands -> presentation 'renders events'
      presentation -> libswamp 'event types only'
      libswamp -> domain 'orchestrates'
      infrastructure -> domain 'implements ports'
    }

    serve = container 'swamp serve' {
      technology 'Deno.serve — one port; WebSocket protocol, HTTP data plane, JSON routes, SSE'
      description 'Runs primitives for remote CLIs, cron schedules and webhooks; hosts the worker pool and the dashboard. Reuses the libswamp use cases.'
      link ../../src/serve
    }

    worker = container 'swamp worker connect' {
      technology 'Same binary; outbound WSS only'
      description 'Disposable executor with no repo, datastore or vault. Dials home, enrols with a token, accepts dispatches.'
      link ../../src/worker
    }

    runner = container 'dispatch runner' {
      technology 'Child process per dispatch; length-prefixed JSON over stdio'
      description 'Isolation boundary for extension code on a worker (swamp worker exec-dispatch).'
      link ../../src/worker/exec_dispatch.ts
    }

    dashboard = container 'Dashboard SPA' {
      technology 'React 19, Vite; embedded in the binary'
      description 'Browser UI at /dashboard/*: workflows, runs, schedules, webhooks, vaults, data, extensions, approvals.'
      link ../../packages/dashboard
    }

    repo = datastore '.swamp/ repo datastore' {
      technology 'YAML, versioned files, SQLite catalogs, JSONL, AES-GCM secrets'
      description 'Definitions, versioned data, outputs, workflow runs, run_tracker.db, _catalog.db, local vault, audit log.'
    }

    control = datastore 'control-plane store' {
      technology 'KV under _control/ — filesystem locally, datastore extension when shared'
      description 'How serve instances coordinate: heartbeats, active runs, pending runs, cron dedup, token secrets.'
      link ../../src/domain/datastore/control_plane_store.ts
    }

    userconfig = datastore '~/.config/swamp' {
      technology 'JSON files'
      description 'swamp-club credentials, serve credentials, anonymous identity, telemetry spool.'
    }

    // container relationships
    cli -> repo 'reads and writes' 'filesystem, SQLite'
    cli -> userconfig 'stores credentials, spools telemetry'
    cli -> serve 'runs commands with --server' 'WSS, bearer token'
    serve -> repo 'reads and writes' 'filesystem, SQLite'
    serve -> control 'heartbeats, leases, dedup' 'KV'
    serve -> dashboard 'serves'
    dashboard -> serve 'commands and health stream' 'WS bearer subprotocol, SSE'
    worker -> serve 'enrol, receive dispatches, capability verbs' 'WSS rpc'
    worker -> runner 'spawns one per dispatch' 'stdio frames'
    runner -> serve 'reads and writes data, fetches bundles' 'HTTPS data plane, bearer'
  }

  // ---- Cross-boundary relationships ----------------------------------------

  builder -> swamp.cli 'prompts the agent; the agent runs swamp'
  author -> swamp.cli 'auth login, extension push and pull'
  operator -> swamp.serve 'serve, access token mint, grants, worker token create'
  operator -> swamp.worker 'worker connect on each machine'
  member -> swamp.cli 'auth server-login, --server commands'
  member -> swamp.dashboard 'browser'
  integrator -> swamp.serve 'HMAC-signed webhook POST' 'HTTPS'

  swamp.cli -> club 'login, whoami, extension push and pull, issues, update check' 'HTTPS JSON'
  swamp.serve -> club 'instance heartbeat, collective refresh, OAuth device grant' 'HTTPS JSON'
  swamp.cli -> wrapped 'executes model methods'
  swamp.runner -> wrapped 'executes placed model methods'
  swamp.cli -> backends 'in-process datastore and vault providers'
  swamp.serve -> backends 'in-process datastore and vault providers; shared control plane'
  swamp.cli -> otel 'traces and logs, opt-in' 'OTLP/HTTP'
  swamp.serve -> otel 'traces and logs, opt-in' 'OTLP/HTTP'
  osd -> swamp.serve 'spawns and restarts'
  osd -> swamp.worker 'spawns and restarts'

  // Summary relationships for the System Context view. Without these the
  // context view merges the container-level edges above into an unlabelled
  // "[...]" edge.
  operator -> swamp 'serve, tokens, grants, worker fleets'
  member -> swamp 'run workflows with --server or the dashboard'
  swamp -> club 'login, registry, issues, heartbeat, OAuth' 'HTTPS JSON'
  swamp -> wrapped 'executes model methods'
  swamp -> backends 'in-process datastore and vault providers'
}
