// Views over model.c4. Static views are hand-curated; dynamic views are one
// per user journey and link to the swamp-uat test that proves the journey.

views {

  view context {
    title 'System Context — who uses swamp and what it talks to'
    include builder, author, operator, member, integrator
    include swamp, club, wrapped, backends, otel, osd
    autoLayout LeftRight
  }

  view containers of swamp {
    title 'Containers — one binary, four runtime roles'
    include *
    include builder, operator, member, integrator, club, osd
    exclude swamp.cli.*
    autoLayout TopBottom
  }

  view cliComponents of swamp.cli {
    title 'Components — layering inside the CLI (and serve, which reuses libswamp)'
    include *
    autoLayout TopBottom
  }

  // ---- Journeys -------------------------------------------------------------

  dynamic view journeyLocalRun {
    title 'Builder: run my model and see the data'
    description 'swamp-uat tests/cli/tutorial/hello_world_test.ts'
    link https://github.com/swamp-club/swamp-uat/blob/main/tests/cli/tutorial/hello_world_test.ts
    builder -> swamp.cli 'agent runs: swamp model method run hello-world execute'
    swamp.cli -> swamp.repo 'load definition, bundle the type, evaluate CEL, resolve vault sentinels'
    swamp.cli -> wrapped 'execute the method in-process'
    swamp.cli -> swamp.repo 'write versioned data, update _catalog.db, record output'
    builder -> swamp.cli 'agent runs: swamp data query'
    swamp.cli -> swamp.repo 'read latest'
  }

  dynamic view journeyApproval {
    title 'Builder: run a workflow that waits for my approval'
    description 'swamp-uat tests/cli/e2e/workflow_manual_approval_test.ts'
    link https://github.com/swamp-club/swamp-uat/blob/main/tests/cli/e2e/workflow_manual_approval_test.ts
    builder -> swamp.cli 'swamp workflow run'
    swamp.cli -> swamp.repo 'topological levels, forEach expansion, run steps'
    swamp.cli -> swamp.repo 'manual_approval step: persist run as suspended'
    builder -> swamp.cli 'swamp workflow approve'
    swamp.cli -> swamp.repo 'record decision, resume from the suspended level'
  }

  dynamic view journeyRemoteRun {
    title 'Team member: run it on the server'
    description 'swamp-uat tests/cli/serve/none/operations_test.ts, tests/cli/serve/access/enforcement_test.ts'
    link https://github.com/swamp-club/swamp-uat/blob/main/tests/cli/serve/access/enforcement_test.ts
    member -> swamp.cli 'swamp workflow run --server'
    swamp.cli -> swamp.serve 'workflow.run frame over WSS with bearer token'
    swamp.serve -> swamp.serve 'verify token, rate limit, evaluate grants'
    swamp.serve -> swamp.repo 'same libswamp use case as the CLI'
    swamp.serve -> swamp.control 'register active run for run.attach'
    swamp.serve -> swamp.cli 'stream events; run.attach(afterSeq) on reconnect'
  }

  dynamic view journeyPlacedStep {
    title 'Fleet operator: this step must run on a labelled machine'
    description 'swamp-uat tests/cli/worker/dispatch/placement_test.ts, lifecycle_test.ts'
    link https://github.com/swamp-club/swamp-uat/blob/main/tests/cli/worker/dispatch/placement_test.ts
    operator -> swamp.worker 'swamp worker connect --token … --label pool=gpu'
    swamp.worker -> swamp.serve 'worker.enroll'
    swamp.serve -> swamp.serve 'step has placement.labels: choose eligible worker, take a lease'
    swamp.serve -> swamp.worker 'worker.dispatch {bundle fingerprint, env snapshot, credential}'
    swamp.worker -> swamp.runner 'spawn exec-dispatch'
    swamp.runner -> swamp.serve 'GET /bundle/{fingerprint}; capability verbs; write data'
    swamp.runner -> wrapped 'execute the method'
    swamp.worker -> swamp.serve 'runner.result'
    swamp.serve -> swamp.repo 'rebuild output orchestrator-side'
  }

  dynamic view journeyPublish {
    title 'Extension author: publish to my collective'
    description 'swamp-uat tests/club/flows/extensions.spec.ts, tests/cli/e2e/extension_workflow_test.ts'
    link https://github.com/swamp-club/swamp-uat/blob/main/tests/cli/e2e/extension_workflow_test.ts
    author -> swamp.cli 'swamp extension push'
    swamp.cli -> swamp.userconfig 'load API key'
    swamp.cli -> club 'GET /api/whoami — collective ownership'
    swamp.cli -> swamp.cli 'safety analysis, dependency trust, fmt and lint, review rules, bundle'
    swamp.cli -> club 'POST push → presigned URL; upload archive; POST confirm'
    author -> swamp.cli 'teammate: swamp extension pull'
    swamp.cli -> club 'download, checksum'
    swamp.cli -> swamp.repo 'safe extract, lockfile, catalog commit'
  }
}
